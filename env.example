# Core API Keys (At least one is recommended)
# GEMINI_API_KEY supports multiple keys comma-separated for automatic failover
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Podcast Index API (https://api.podcastindex.org) - powers podcast search and
# the Trending / Browse discovery tabs. Free to register at
# https://api.podcastindex.org/signup. Without these, search silently falls
# back to the iTunes directory (thinner descriptions) and the Trending/Browse
# tabs report that discovery is not configured.
#
# These seed the install. Once set from Admin > System > "Podcast Discovery",
# the stored values take precedence over what is here.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Application Settings
LOG_LEVEL=INFO
CHECK_INTERVAL_MINUTES=60
BASE_URL=http://localhost:8000

# Session cookie signing key. REQUIRED - the built-in default is public (it's
# in this repo's source), so leaving it unset means anyone can forge a login
# session. Generate one with: openssl rand -hex 32
SESSION_SECRET_KEY=

# Set to true ONLY if a reverse proxy sits in front of this app and you have
# verified it overwrites (not merges) CF-Connecting-IP / X-Forwarded-For /
# X-Real-IP on every request. When true, those headers determine the client
# IP used by the IP allowlist and login rate-limiting; a direct connection to
# this app (bypassing your proxy) can otherwise spoof any allowlisted IP.
# Defaults to false (direct connection IP only).
TRUST_PROXY_HEADERS=false

# Public Application URL - NOT an environment variable.
#
# It is a stored setting, edited at Admin > System > "Public Application URL",
# and it is auto-detected on first boot as http://<LAN-IP>:8000.
#
# If you put this app behind a reverse proxy, set it to the exact URL your
# browser uses, including scheme, host and port (e.g. https://podcasts.example.com).
# Every admin form POST is same-origin checked against that value and against
# the Host header, so if it is wrong AND your proxy does not forward the public
# Host header, every admin save returns 403 "Cross-origin or origin-less request
# rejected" - including the save that would correct it. Recovery in that state is
# to reach the app directly on http://<host>:8000, bypassing the proxy, and fix it
# there. See Documentation/Deployment.md.
#
# BASE_URL above is a fallback for feed URLs only. It is NOT consulted by the
# same-origin check.

# Whisper Configuration
WHISPER_MODEL=base
